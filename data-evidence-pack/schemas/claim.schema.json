{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/claim.schema.json",
  "title": "Atomic Claim Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim",
    "source_id",
    "source_locator",
    "observed_at",
    "priority",
    "verification",
    "sensitivity",
    "owner",
    "verifier",
    "verdict",
    "notes"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_locator": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "verification": {
      "enum": [
        "UNVERIFIED",
        "VERIFIED",
        "DISPUTED",
        "REFUTED"
      ]
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "verifier": {
      "type": [
        "string",
        "null"
      ]
    },
    "verdict": {
      "enum": [
        "NOT_CHECKED",
        "SUPPORTED",
        "UNSUPPORTED",
        "DISPUTED",
        "REFUTED",
        "OUTDATED",
        "NOT_CHECKABLE"
      ]
    },
    "notes": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "measured_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
